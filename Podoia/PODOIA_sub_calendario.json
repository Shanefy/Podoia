        "end": "={{ (() => { const [h,m] = $('Parsear Params').item.json.time.split(':').map(Number); const endMin = h*60+m+$('Parsear Params').item.json.slotMinutes; const eh = Math.floor(endMin/60).toString().padStart(2,'0'); const em = (endMin%60).toString().padStart(2,'0'); return $('Parsear Params').item.json.date + 'T' + eh + ':' + em + ':00'; })() }}",
