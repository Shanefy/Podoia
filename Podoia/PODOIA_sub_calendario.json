    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "={{ $('Parsear Params').item.json.calendarId }}",
          "mode": "id"
        },
        "timeMin": "={{ $('Parsear Params').item.json.date }}T00:00:00Z",
        "timeMax": "={{ $('Parsear Params').item.json.date }}T23:59:59Z",
        "options": {}
