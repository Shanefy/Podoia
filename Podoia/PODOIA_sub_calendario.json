      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        700,
        60
      ],
      "id": "ca39d448-bf21-402a-99b9-3843003661b1",
      "name": "Obtener Eventos",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "CAMBIAR",
          "name": "Google Calendar"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst params = $('Parsear Params').item.json;\nconst eventos = $input.all().map(i => i.json);\nconst date = params.date;\nconst slotMin = params.slotMinutes;\nconst breakMin = params.breakMinutes;\n\nconst [sh,sm] = params.dayStart.split(':').map(Number);\nconst [eh,em] = params.dayEnd.split(':').map(Number);\nconst dayStartMin = sh*60+sm;\nconst dayEndMin = eh*60+em;\n\nconst busy = eventos\n  .filter(e => e.start && e.start.dateTime)\n  .map(e => {\n    const s = new Date(e.start.dateTime);\n    const en = new Date(e.end.dateTime);\n    return { start: s.getHours()*60+s.getMinutes(), end: en.getHours()*60+en.getMinutes() };\n  })\n  .sort((a,b) => a.start-b.start);\n\nconst slots = [];\nlet cursor = dayStartMin;\nfor (const b of busy) {\n  while (cursor + slotMin <= b.start) {\n    const h = Math.floor(cursor/60).toString().padStart(2,'0');\n    const m = (cursor%60).toString().padStart(2,'0');\n    slots.push(`${h}:${m}`);\n    cursor += slotMin + breakMin;\n  }\n  cursor = Math.max(cursor, b.end + breakMin);\n}\nwhile (cursor + slotMin <= dayEndMin) {\n  const h = Math.floor(cursor/60).toString().padStart(2,'0');\n  const m = (cursor%60).toString().padStart(2,'0');\n  slots.push(`${h}:${m}`);\n  cursor += slotMin + breakMin;\n}\n\nconst slotsText = slots.length > 0\n  ? `Horarios disponibles para ${date}: ${slots.join(', ')}`\n  : `No hay horarios disponibles para ${date}. Sugiere otra fecha.`;\n\nreturn [{ json: { available_slots: slots, date, message: slotsText, slots_count: slots.length }}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        60
      ],
      "id": "f6215b04-ea67-4cb7-9009-d19b4a0b8202",
      "name": "Calcular Slots"
    },
    {
      "parameters": {
        "jsCode": "\nconst p = $('Parsear Params').item.json;\nconst errores = [];\nif (!p.patientName || p.patientName.trim().length < 2) errores.push('nombre completo del paciente');\nif (!p.patientPhone || p.patientPhone.trim().length < 8) errores.push('teléfono del paciente');\nif (!p.treatment || p.treatment.trim().length < 3) errores.push('tipo de tratamiento/servicio');\nif (!p.date) errores.push('fecha de la cita');\nif (!p.time) errores.push('hora de la cita');\n\nif (errores.length > 0) {\n  return [{ json: { success: false, valid: false, message: 'No se puede agendar. Faltan datos obligatorios: ' + errores.join(', ') + '. Por favor solicita esta información al paciente antes de agendar.' }}];\n}\nreturn [{ json: { success: true, valid: true, message: 'Datos válidos. Procediendo a agendar.' }}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        570,
        220
      ],
      "id": "0c1160bf-4e39-4870-91e2-aaaf77cb80f1",
      "name": "Validar Datos"
