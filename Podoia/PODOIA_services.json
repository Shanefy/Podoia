            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "06363879-8dce-4771-b1ad-24e004eb8ec2",
              "leftValue": "={{ Array.isArray($json) && $json.length > 0 }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
