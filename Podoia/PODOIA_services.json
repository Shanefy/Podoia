      ],
      "id": "9e91a462-e064-4779-80a2-210ae0bde82f",
      "name": "Hay Servicios?"
    },
    {
      "parameters": {
        "jsCode": "\nconst q = $('Parsear Input').item.json.query || '';\nlet services = Array.isArray($json) ? $json : [$json];\n// Filter by query if provided (simple includes match)\nif (q.length > 2) {\n  const filtered = services.filter(s => s.name.toLowerCase().includes(q));\n  if (filtered.length > 0) services = filtered;\n}\nconst formatted = services.map(s => {\n  const price = s.price ? `R$${Number(s.price).toFixed(2)}` : 'consultar';\n  const dur = s.duration_minutes ? `${s.duration_minutes} min` : '';\n  return `- ${s.name}: ${price}${dur ? ' ('+dur+')' : ''}`;\n}).join('\\n');\nreturn [{ json: {\n  found: true,\n  count: services.length,\n  services: services,\n  formatted: `Serviços disponíveis:\\n${formatted}`\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        120
      ],
      "id": "fea83f8c-54ea-4607-972e-fa582bd5f02f",
      "name": "Formatear Servicios"
    },
    {
      "parameters": {
        "jsCode": "\nreturn [{ json: {\n  found: false,\n  count: 0,\n  services: [],\n  formatted: 'No encontramos servicios configurados. Por favor consulte directamente con la clínica.'\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
