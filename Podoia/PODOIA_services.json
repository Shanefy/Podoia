{
  "name": "PODOIA - Services",
  "nodes": [
    {
      "parameters": {
        "content": "## PODOIA_services — Catálogo de servicios\n\nLlamado por el Agente IA como herramienta.\n\n**Input:** { client_id, query }\n**Output:** { found, services[], formatted }\n\n**Tabla Supabase:** services\n(id, client_id, name, price, duration_minutes, is_active)\n\n**Regla:** Solo lee datos. Nunca modifica.",
        "height": 220,
        "width": 500,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -360,
        -80
      ],
      "id": "f68f05b0-2529-4c65-8c1f-967e5d9bd764",
      "name": "Nota"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "id": "c7a46851-48fd-4383-8b02-c827afdd339b",
      "name": "Trigger"
    },
    {
      "parameters": {
        "jsCode": "\nconst input = $json.query ? (typeof $json.query === 'string' ? (() => { try { return JSON.parse($json.query); } catch(e) { return $json; } })() : $json.query) : $json;\nreturn [{ json: {\n  client_id: input.client_id || $json.client_id || '',\n  query: (input.query || $json.query || '').toLowerCase().trim()\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "id": "1f8b2fa0-9887-4c70-a987-6c6de31f47b9",
