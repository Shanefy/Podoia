    {
      "parameters": {
        "jsCode": "\nconst input = $json.query ? (typeof $json.query === 'string' ? (() => { try { return JSON.parse($json.query); } catch(e) { return {}; } })() : $json.query) : $json;\nconst rawAction = (input.action || $json.action || 'confirmar').toLowerCase();\nlet action = 'confirmar';\nif (rawAction.includes('cancel')) action = 'cancelar';\nelse if (rawAction.includes('reagend') || rawAction.includes('cambiar') || rawAction.includes('reprog')) action = 'reagendar';\nreturn [{ json: {\n  action,\n  phone: input.phone || $json.phone || '',\n  client_id: input.client_id || $json.client_id || '',\n  business_phone_id: input.business_phone_id || $json.business_phone_id || '',\n  idioma: input.idioma || $json.idioma || 'Portugués'\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        700
      ],
      "id": "432654b3-aea3-485e-804e-b0e9b54a4588",
      "name": "Parsear Accion"
    },
