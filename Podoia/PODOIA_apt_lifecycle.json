    {
      "parameters": {
        "jsCode": "\nconst cita = Array.isArray($json) ? $json[0] : $json;\nconst action = $('Parsear Accion').item.json.action;\nconst newStatus = (action === 'confirmar') ? 'confirmado' : 'cancelado';\nreturn [{ json: {\n  appointment_id: cita.id,\n  patient_id: cita.patient_id,\n  patient_name: cita.patients?.name || 'paciente',\n  phone: cita.patients?.phone || $('Parsear Accion').item.json.phone,\n  business_phone_id: $('Parsear Accion').item.json.business_phone_id,\n  date: cita.date,\n  time: cita.time ? cita.time.substring(0,5) : '',\n  treatment: cita.treatment || 'consulta',\n  action,\n  new_status: newStatus,\n  client_id: $('Parsear Accion').item.json.client_id,\n  idioma: $('Parsear Accion').item.json.idioma\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
