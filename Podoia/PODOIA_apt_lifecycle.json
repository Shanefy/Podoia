        "url": "=https://CAMBIAR-URL.supabase.co/rest/v1/appointments?select=*,patients(name,phone)&patients.phone=eq.{{ $json.phone }}&client_id=eq.{{ $json.client_id }}&status=in.(pendiente,confirmado)&date=gte.{{ new Date().toISOString().split('T')[0] }}&date=lte.{{ new Date(Date.now()+172800000).toISOString().split('T')[0] }}&limit=1",
        "authentication": "genericCredentialType",
