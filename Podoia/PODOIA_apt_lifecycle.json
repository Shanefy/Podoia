    {
      "parameters": {
        "jsCode": "const c=$json; const name=c.patients?.name||'paciente'; const phone=c.patients?.phone||'';\nconst time=c.time?c.time.substring(0,5):''; const treatment=c.treatment||'consulta';\nreturn [{json:{phone, mensaje:`Olá ${name}! 👋 Lembramos da sua consulta de ${treatment} agendada para amanhã às ${time}. Confirme respondendo SIM ou, para reagendar, responda REAGENDAR. Esperamos você!`}}];"
      },
      "type": "n8n-nodes-base.code",
