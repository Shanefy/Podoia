    {
      "parameters": {
        "jsCode": "\nconst d = $('Parsear Accion').item.json;\nconst isPortugues = (d.idioma || '').toLowerCase().includes('portugu');\nconst msg = isPortugues\n  ? '🔍 Não encontramos nenhuma consulta próxima associada ao seu número. Se precisar de ajuda, pode nos contar o que precisas!'\n  : '🔍 No encontramos ninguna cita próxima asociada a tu número. ¡Dinos en qué podemos ayudarte!';\nreturn [{ json: { phone: d.phone, business_phone_id: d.business_phone_id, mensaje: msg }}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
