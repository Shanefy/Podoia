      "name": "Patch Status DB",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CAMBIAR",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst d = $('Actualizar Status Cita').item.json;\nconst action = d.action;\nconst idioma = d.idioma || 'Portugués';\nconst isPortugues = idioma.toLowerCase().includes('portugu');\nlet msg;\nif (action === 'confirmar') {\n  msg = isPortugues\n    ? `✅ Perfeito, ${d.patient_name}! Sua consulta de ${d.treatment} foi confirmada para ${d.date} às ${d.time}. Te esperamos! 🦶`\n    : `✅ ¡Perfecto, ${d.patient_name}! Tu consulta de ${d.treatment} está confirmada para el ${d.date} a las ${d.time}. ¡Te esperamos! 🦶`;\n} else if (action === 'cancelar') {\n  msg = isPortugues\n    ? `❌ Tudo bem, ${d.patient_name}. Sua consulta de ${d.treatment} foi cancelada. Se quiser reagendar, é só nos escrever! 😊`\n    : `❌ Entendido, ${d.patient_name}. Tu consulta de ${d.treatment} ha sido cancelada. Si quieres reagendar, escríbenos. 😊`;\n} else {\n  // reagendar\n  msg = isPortugues\n    ? `🔄 Claro, ${d.patient_name}! Cancelei sua consulta de ${d.treatment} que estava para ${d.date} às ${d.time}. Qual dia e horário prefere para remarcar? 📅`\n    : `🔄 Claro, ${d.patient_name}. Cancelé tu consulta de ${d.treatment} del ${d.date} a las ${d.time}. ¿Qué día y horario prefieres para reagendar? 📅`;\n}\nreturn [{ json: { phone: d.phone, business_phone_id: d.business_phone_id, mensaje: msg }}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        600
