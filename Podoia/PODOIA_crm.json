    {
      "parameters": {
        "jsCode": "\nconst intent = $json.intent;\nconst patientId = $json.patient_id;\nconst currentStatus = $json.patient_status || 'nuevo';\nconst currentScore = $json.patient_score || 0;\nconst agentOutput = $json.respuesta_agente || '';\n\nconst TRANSITIONS = {\n  agendar:     { score: +3, status: 'lead',    tags: ['interesado'] },\n  confirmar:   { score: +5, status: 'cliente',  tags: ['cita_agendada'] },\n  consultar:   { score: +1, status: currentStatus === 'nuevo' ? 'lead' : currentStatus, tags: [] },\n  precios:     { score: +2, status: currentStatus === 'nuevo' ? 'lead' : currentStatus, tags: ['pidio_precios'] },\n  urgencia:    { score: +3, status: 'lead',    tags: ['urgente'] },\n  reprogramar: { score: +0, status: currentStatus, tags: [] },\n  cancelar:    { score: -2, status: currentStatus, tags: ['cancelo'] },\n  seguimiento: { score: +1, status: currentStatus, tags: [] },\n  saludo:      { score: +0, status: currentStatus, tags: [] },\n  otro:        { score: +0, status: currentStatus, tags: [] }\n};\n\nconst t = TRANSITIONS[intent] || TRANSITIONS['otro'];\nlet finalStatus = t.status;\nif (currentStatus === 'inactivo' && intent !== 'saludo' && intent !== 'otro') {\n  finalStatus = 'lead';\n  t.tags.push('reactivado');\n}\nconst agentoAgendo = agentOutput.toLowerCase().includes('cita confirmada') ||\n                     agentOutput.toLowerCase().includes('agendada') ||\n                     agentOutput.toLowerCase().includes('evento criado');\nif (agentoAgendo && finalStatus !== 'cliente') {\n  finalStatus = 'cliente';\n  t.score = Math.max(t.score, 5);\n  if (!t.tags.includes('cita_agendada')) t.tags.push('cita_agendada');\n}\nreturn [{ json: {\n  patient_id: patientId,\n  new_status: finalStatus,\n  new_score: Math.max(0, currentScore + t.score),\n  new_tags: t.tags,\n  intent,\n  mensaje_usuario: $json.mensaje_usuario,\n  respuesta_agente: agentOutput,\n  client_id: $json.client_id\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
