        "jsCode": "\nconst tags = $('Maquina de Estados CRM').item.json.new_tags || [];\nconst patientId = $('Maquina de Estados CRM').item.json.patient_id;\nif (!patientId || tags.length === 0) return [{ json: { done: true, tags_added: 0 } }];\nconst body = tags.map(t => ({ patient_id: patientId, tag: t }));\nreturn [{ json: { tags_to_insert: body, count: tags.length } }];\n"
